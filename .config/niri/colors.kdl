layout {
	background-color "#12140d"

    focus-ring {
        active-color "#bacf83"
        inactive-color "#909284"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bacf83"
        inactive-color "#909284"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bacf83"
        inactive-color "#909284"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bacf8380"
    }
}

overview {
	backdrop-color "#12140d"
}

recent-windows {
    highlight {
        active-color "#bacf83"
        urgent-color "#ffb4ab"
    }
}
