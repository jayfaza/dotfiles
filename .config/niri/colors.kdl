layout {
	background-color "#19120c"

    focus-ring {
        active-color "#fcb974"
        inactive-color "#9d8e81"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#fcb974"
        inactive-color "#9d8e81"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#fcb974"
        inactive-color "#9d8e81"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#fcb97480"
    }
}

overview {
	backdrop-color "#19120c"
}

recent-windows {
    highlight {
        active-color "#fcb974"
        urgent-color "#ffb4ab"
    }
}
