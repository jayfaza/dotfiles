layout {
	background-color "#0f1416"

    focus-ring {
        active-color "#84d2e6"
        inactive-color "#899295"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#84d2e6"
        inactive-color "#899295"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#84d2e6"
        inactive-color "#899295"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#84d2e680"
    }
}

overview {
	backdrop-color "#0f1416"
}

recent-windows {
    highlight {
        active-color "#84d2e6"
        urgent-color "#ffb4ab"
    }
}
