{
    "layer": "top",
    "position": "top",
    "height": 32,

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "pulseaudio",
        "battery"
    ],

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip": false
    },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "Offline",
        "tooltip": false,
        "on-click": "wifitui"
    },

    "niri/language": {
        "format": "{}"
    },

    "pulseaudio": {
        "format": "   {volume}%",
        "format-muted": "󰝟   Muted",
        "tooltip": false,
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },

    "battery": {
        "format": "  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-full": "  100%",
        "states": {
            "good": 95,
            "warning": 25,
            "critical": 10
        },
        "tooltip": true
    }
}
