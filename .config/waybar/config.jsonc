{
    "layer": "top",
    "position": "top",
    "height": 27, 
    "spacing": 10,

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "niri/language",
        "network",
        "pulseaudio",
        "battery"
    ],

    "clock": {
        "format": "{:%a, %b %e %I:%M %p}",
        "tooltip": true 
    },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",
        "format-disconnected": "Offline",
        "tooltip": false,
        "on-click": "wifitui"
    },

    "niri/language": {
        "format": "{short}"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "󰝟",
        "tooltip": false,
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },

    "battery": {
        "format-full": "  100%",
        "format": "{icon} {capacity}% ",
        "format-charging": " {icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "good": 95,
            "warning": 25,
            "critical": 10
        },
        "tooltip": true
    },
}
